# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Behind a load balancer: number of proxy hops in front of the app (usually 1) or a comma-separated list of proxy IPs/CIDRs. Never "true" (client could spoof its IP).
TRUST_PROXY=false

# Supabase -> Project Settings -> Database -> Connection string (Session pooler)
DATABASE_URL=postgresql://postgres.vrckchkooikpvmbinsed:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://vrckchkooikpvmbinsed.supabase.co
# Supabase -> Project Settings -> API keys
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still on the legacy HS256 JWT secret; leave empty to verify via JWKS
SUPABASE_JWT_SECRET=

# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
OTP_SECRET=
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=27
LOGIN_OTP_REQUIRED=true

# resend | console (console prints codes to the log; development only)
NOTIFIER=resend
RESEND_API_KEY=
EMAIL_FROM=Pipeline <no-reply@pipelinepub.com>

TERMS_VERSION=2026-10-01
# Comma-separated browser origins allowed by CORS (mobile apps don't need any)
CORS_ORIGINS=
# Required when running more than one instance (shared rate limits)
REDIS_URL=
# Defaults to true outside production
DOCS_ENABLED=

# Supabase Storage bucket for profile photos (public; created automatically on first upload).
AVATAR_BUCKET=avatars

RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_EMAIL_PER_15_MIN=10
